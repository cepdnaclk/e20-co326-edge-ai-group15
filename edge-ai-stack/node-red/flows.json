  {
    "id": "format_relay_html",
    "type": "function",
    "z": "f1a2b3c4d5e6f701",
    "name": "Format Motor Status",
    "func": "const motorState = String(msg.payload.motor_state || 'ON');\nconst vibration = Number(msg.payload.vibration || 0).toFixed(4);\nif (motorState === 'OFF') {\n    msg.payload = '<span style=\"color:#ca3838;font-weight:bold;\">OFF</span><br/><span style=\"color:#666;\">Motor stopped after abnormality at ' + vibration + ' g</span>';\n} else {\n    msg.payload = '<span style=\"color:#00b500;font-weight:bold;\">ON</span><br/><span style=\"color:#666;\">Motor running normally</span>';\n}\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 630,
    "y": 420,
    "wires": [
      [
        "ui_text_relay_status"
      ]
    ]
  },
  {
    "id": "format_live_status_html",
    "type": "function",
    "z": "f1a2b3c4d5e6f701",
    "name": "Format Live Status",
    "func": "const status = String(msg.payload.status || 'NORMAL');\nconst confidence = Number(msg.payload.ai_confidence || 0).toFixed(2);\nconst motorState = String(msg.payload.motor_state || 'ON');\nif (status === 'FAULT') {\n    msg.payload = '<span style=\"color:#ca3838;font-weight:bold;\">FAULT DETECTED (AI Confidence: ' + confidence + ', Motor ' + motorState + ')</span>';\n} else if (motorState === 'OFF' || status === 'MOTOR_OFF') {\n    msg.payload = '<span style=\"color:#ca3838;font-weight:bold;\">MOTOR OFF</span>';\n} else {\n    msg.payload = '<span style=\"color:#00b500;font-weight:bold;\">NORMAL (AI Confidence: ' + confidence + ')</span>';\n}\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 630,
    "y": 270,
    "wires": [
      [
        "ui_text_status"
      ]
    ]
  },
  {
    "id": "extract_confidence",
    "type": "function",
    "z": "f1a2b3c4d5e6f701",
    "name": "Extract Confidence",
    "func": "msg.payload = Number(msg.payload.ai_confidence || 0) * 100;\nmsg.topic = 'AI Confidence';\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 630,
    "y": 320,
    "wires": [
      [
        "ui_gauge_confidence"
      ]
    ]
  },
  {
    "id": "format_prediction_html",
    "type": "function",
    "z": "f1a2b3c4d5e6f701",
    "name": "Format Prediction",
    "func": "const status = String(msg.payload.status || 'NORMAL');\nconst confidence = (Number(msg.payload.ai_confidence || 0) * 100).toFixed(1);\nconst method = msg.payload.detection_method || 'isolation_forest';\nif (status === 'FAULT') {\n    msg.payload = '<span style=\"color:#ca3838;font-weight:bold;\">ANOMALY - ' + confidence + '% confidence (' + method + ')</span>';\n} else if (status === 'MOTOR_OFF') {\n    msg.payload = '<span style=\"color:#ca3838;font-weight:bold;\">MOTOR OFF - synthetic vibration stopped</span>';\n} else {\n    msg.payload = '<span style=\"color:#00b500;font-weight:bold;\">NORMAL - ' + confidence + '% confidence (' + method + ')</span>';\n}\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 630,
    "y": 370,
    "wires": [
      [
        "ui_text_prediction"
      ]
    ]
