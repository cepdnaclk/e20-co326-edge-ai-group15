  {
    "id": "format_status_html",
    "type": "function",
    "z": "f1a2b3c4d5e6f701",
    "name": "Format Status HTML",
    "func": "const status = String(msg.payload.status || 'NORMAL');\nconst confidence = Number(msg.payload.ai_confidence || 0).toFixed(2);\nif (status === 'FAULT') {\n    msg.payload = '<span style=\"color:#ca3838;font-weight:bold;\">\u26a0 FAULT DETECTED (AI Confidence: ' + confidence + ')</span>';\n} else {\n    msg.payload = '<span style=\"color:#00b500;font-weight:bold;\">\u2714 NORMAL (AI Confidence: ' + confidence + ')</span>';\n}\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 620,
    "y": 220,
